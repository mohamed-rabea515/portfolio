<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mohamed Rabea Ali — Cybersecurity Student &amp; QA Tester</title>
<meta name="description" content="Portfolio of Mohamed Rabea Ali, Cybersecurity student and Software QA Tester based in Cairo, Egypt.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Cairo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
/* ============================================================
   Mohamed Rabea Ali — Portfolio
   Palette:  #0B1220 ink / #121A2B surface / #182238 surface-2
             #12C7B8 accent (teal) / #F2A65A accent-2 (amber)
             #E7ECF5 text / #93A0BC muted
   Type:     Space Grotesk (display) / Inter (body) / Cairo (Arabic)
   ============================================================ */

:root{
  --bg: #0b1220;
  --surface: #101a2c;
  --surface-2: #16223a;
  --border: #24314c;
  --text: #e7ecf5;
  --text-muted: #90a0bf;
  --accent: #16d1c1;
  --accent-strong: #0fb3a5;
  --accent-2: #f2a65a;
  --accent-soft: rgba(22, 209, 193, .12);
  --font-display: "Space Grotesk", "Cairo", sans-serif;
  --font-body: "Inter", "Cairo", sans-serif;
  --font-mono: "IBM Plex Mono", monospace;
  --radius: 10px;
  --radius-lg: 18px;
  --max-w: 1180px;
  --transition: 220ms cubic-bezier(.4,0,.2,1);
}

*{ box-sizing: border-box; }
html{ scroll-behavior: smooth; }
html, body{ height: 100%; }

body{
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

html[dir="rtl"] body{ font-family: "Cairo", var(--font-body); }

a{ color: inherit; text-decoration: none; }
ul{ margin: 0; padding: 0; list-style: none; }
img{ max-width: 100%; display: block; }
button{ font: inherit; cursor: pointer; }

::selection{ background: var(--accent); color: #04201d; }

/* ---------- decorative backdrop ---------- */
.grid-backdrop{
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(22,209,193,.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(22,209,193,.055) 1px, transparent 1px);
  background-size: 42px 42px;
  mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 40%, transparent 85%);
}

/* ---------- layout helpers ---------- */
.section-inner{
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 28px;
  position: relative;
  z-index: 1;
}
.section{ padding: 96px 0; }
.section-alt{ background: linear-gradient(180deg, transparent, rgba(255,255,255,.015) 12%, rgba(255,255,255,.015) 88%, transparent); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

.section-heading{
  display: flex;
  align-items: baseline;
  gap: 14px;
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 2.6vw, 2.15rem);
  font-weight: 600;
  margin: 0 0 44px;
  color: var(--text);
}
.heading-index{
  font-family: var(--font-mono);
  font-size: .95rem;
  color: var(--accent);
  border: 1px solid var(--border);
  padding: 4px 9px;
  border-radius: 6px;
  background: var(--accent-soft);
}

/* ============ HEADER ============ */
.site-header{
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(14px);
  background: rgba(11,18,32,.78);
  border-bottom: 1px solid var(--border);
}
.header-inner{
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 14px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.brand{ display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; }
.brand-mark{
  width: 34px; height: 34px;
  display: grid; place-items: center;
  border-radius: 8px;
  background: linear-gradient(145deg, var(--accent), var(--accent-strong));
  color: #04201d;
  font-family: var(--font-mono);
  font-size: .8rem;
  font-weight: 700;
}

.main-nav{ display: flex; gap: 28px; }
.main-nav a{
  font-size: .93rem;
  color: var(--text-muted);
  transition: color var(--transition);
  position: relative;
  padding: 4px 0;
}
.main-nav a:hover{ color: var(--text); }
.main-nav a::after{
  content: "";
  position: absolute; left: 0; right: 0; bottom: -2px;
  height: 2px; background: var(--accent);
  transform: scaleX(0); transform-origin: left;
  transition: transform var(--transition);
}
.main-nav a:hover::after{ transform: scaleX(1); }

.header-actions{ display: flex; align-items: center; gap: 12px; }

/* language toggle switch */
.lang-toggle{ background: none; border: none; padding: 0; }
.lang-toggle-track{
  position: relative;
  display: flex;
  align-items: center;
  width: 68px; height: 32px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 3px;
}
.lang-toggle-thumb{
  position: absolute;
  top: 3px; left: 3px;
  width: 30px; height: 24px;
  border-radius: 16px;
  background: var(--accent);
  transition: transform var(--transition);
}
html[dir="rtl"] .lang-toggle-thumb{ transform: translateX(-32px); }
.lang-toggle-label{
  position: relative; z-index: 1;
  width: 50%;
  text-align: center;
  font-family: var(--font-mono);
  font-size: .68rem;
  font-weight: 500;
  color: var(--text-muted);
  transition: color var(--transition);
}
html[dir="ltr"] .lang-toggle-label-en{ color: #04201d; }
html[dir="rtl"] .lang-toggle-label-ar{ color: #04201d; }

.whatsapp-btn{
  display: flex; align-items: center; gap: 7px;
  background: var(--accent-2);
  color: #2c1908;
  font-weight: 600;
  font-size: .88rem;
  padding: 8px 15px;
  border-radius: 8px;
  transition: transform var(--transition), box-shadow var(--transition);
}
.whatsapp-btn:hover{ transform: translateY(-1px); box-shadow: 0 8px 20px -8px rgba(242,166,90,.6); }

.nav-toggle{ display: none; flex-direction: column; gap: 5px; background: none; border: none; padding: 6px; }
.nav-toggle span{ width: 22px; height: 2px; background: var(--text); border-radius: 2px; }

/* ============ HERO ============ */
.hero{ padding: 84px 0 70px; position: relative; }
.hero-inner{
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 28px;
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: 56px;
  align-items: center;
  position: relative; z-index: 1;
}
.eyebrow-code{
  font-family: var(--font-mono);
  color: var(--accent);
  font-size: .85rem;
  margin: 0 0 14px;
}
.eyebrow-code::before{ content: "$ "; opacity: .6; }
.hero-name{
  font-family: var(--font-display);
  font-size: clamp(2.3rem, 5vw, 3.4rem);
  line-height: 1.08;
  margin: 0 0 10px;
  font-weight: 700;
}
.hero-title{
  font-size: clamp(1.05rem, 1.6vw, 1.25rem);
  color: var(--accent);
  font-weight: 500;
  margin: 0 0 20px;
}
.hero-bio{
  color: var(--text-muted);
  max-width: 54ch;
  margin: 0 0 26px;
  font-size: 1.02rem;
}
.hero-meta{ display: flex; gap: 18px; margin-bottom: 30px; }
.hero-location{ display: flex; align-items: center; gap: 7px; color: var(--text-muted); font-size: .92rem; }
.hero-location svg{ color: var(--accent-2); flex-shrink: 0; }

.hero-cta{ display: flex; gap: 14px; margin-bottom: 30px; flex-wrap: wrap; }
.btn{
  padding: 12px 24px;
  border-radius: 8px;
  font-weight: 600;
  font-size: .95rem;
  transition: transform var(--transition), box-shadow var(--transition), background var(--transition);
  display: inline-block;
}
.btn-primary{ background: var(--accent); color: #04201d; }
.btn-primary:hover{ transform: translateY(-2px); box-shadow: 0 10px 24px -10px rgba(22,209,193,.55); }
.btn-ghost{ border: 1px solid var(--border); color: var(--text); }
.btn-ghost:hover{ border-color: var(--accent); color: var(--accent); }

.hero-links{ display: flex; gap: 14px; }
.hero-links a{
  width: 38px; height: 38px;
  display: grid; place-items: center;
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text-muted);
  transition: color var(--transition), border-color var(--transition);
}
.hero-links a:hover{ color: var(--accent); border-color: var(--accent); }

.hero-portrait{ position: relative; display: flex; justify-content: center; }
.portrait-frame{
  width: min(320px, 80vw);
  aspect-ratio: 1 / 1.05;
  border-radius: var(--radius-lg);
  background: linear-gradient(160deg, var(--surface-2), var(--surface));
  border: 1px solid var(--border);
  position: relative;
  overflow: hidden;
  display: grid;
  place-items: center;
}
.profile-img{ width: 100%; height: 100%; object-fit: cover; }
.profile-img.img-fallback{ display: none; }
.portrait-fallback-mark{
  display: none;
  font-family: var(--font-display);
  font-size: 4rem; font-weight: 700;
  color: var(--accent);
  letter-spacing: 2px;
}
.profile-img.img-fallback + .portrait-fallback-mark{ display: block; }
.portrait-tag{
  position: absolute;
  background: var(--surface-2);
  border: 1px solid var(--border);
  padding: 8px 14px;
  border-radius: 20px;
  font-size: .8rem;
  font-family: var(--font-mono);
  color: var(--accent);
  box-shadow: 0 10px 24px -10px rgba(0,0,0,.5);
}
.portrait-tag-1{ top: 10%; inset-inline-start: -8%; }
.portrait-tag-2{ bottom: 8%; inset-inline-end: -6%; color: var(--accent-2); }

/* ============ ABOUT ============ */
.about-grid{ max-width: 900px; }
.about-text{ color: var(--text-muted); font-size: 1.08rem; max-width: 68ch; }

/* ============ SKILLS ============ */
.skills-grid{
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.skill-card{
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px 22px;
  transition: border-color var(--transition), transform var(--transition);
}
.skill-card:hover{ border-color: var(--accent); transform: translateY(-3px); }
.skill-card h3{
  font-family: var(--font-display);
  font-size: 1.02rem;
  margin: 0 0 16px;
  color: var(--text);
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}
.skill-card li{
  color: var(--text-muted);
  font-size: .9rem;
  padding: 6px 0;
  position: relative;
  padding-inline-start: 16px;
}
.skill-card li::before{
  content: "";
  position: absolute; inset-inline-start: 0; top: 14px;
  width: 6px; height: 1.5px;
  background: var(--accent-2);
}

/* ============ EDUCATION ============ */
.edu-card{
  display: flex;
  gap: 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 28px;
}
.edu-mark{
  width: 4px;
  border-radius: 4px;
  background: linear-gradient(var(--accent), var(--accent-2));
  flex-shrink: 0;
}
.edu-body h3{ margin: 0 0 10px; font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; max-width: 55ch; }
.edu-major{ color: var(--accent); font-weight: 600; margin: 0 0 4px; font-size: .95rem; }
.edu-status{ color: var(--text-muted); margin: 0; font-size: .9rem; }

/* ============ EXPERIENCE (timeline) ============ */
.timeline{ position: relative; padding-inline-start: 26px; }
.timeline::before{
  content: "";
  position: absolute; inset-inline-start: 5px; top: 6px; bottom: 6px;
  width: 1px; background: var(--border);
}
.timeline-item{ position: relative; padding-bottom: 34px; }
.timeline-item:last-child{ padding-bottom: 0; }
.timeline-dot{
  position: absolute; inset-inline-start: -26px; top: 4px;
  width: 11px; height: 11px; border-radius: 50%;
  background: var(--bg);
  border: 2px solid var(--accent);
}
.timeline-content h3{ margin: 0 0 6px; font-family: var(--font-display); font-size: 1.02rem; font-weight: 600; }
.timeline-content p{ margin: 0; color: var(--text-muted); font-size: .9rem; }

/* ============ PROJECTS ============ */
.projects-grid{
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 26px;
}
.project-card{
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: border-color var(--transition), transform var(--transition);
}
.project-card:hover{ border-color: var(--accent); transform: translateY(-4px); }
.project-cover{
  display: block;
  aspect-ratio: 16 / 9;
  background: var(--surface-2);
  position: relative;
  overflow: hidden;
}
.project-cover img{ width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition); }
.project-card:hover .project-cover img{ transform: scale(1.04); }
.project-cover.cover-fallback{
  display: grid; place-items: center;
}
.project-cover.cover-fallback::after{
  content: "</>";
  font-family: var(--font-mono);
  color: var(--accent);
  font-size: 1.6rem;
  opacity: .55;
}
.project-cover.cover-fallback img{ display: none; }
.project-body{ padding: 22px; }
.project-body h3{ margin: 0 0 10px; font-family: var(--font-display); font-size: 1.08rem; font-weight: 600; }
.project-body p{ margin: 0 0 16px; color: var(--text-muted); font-size: .92rem; }
.project-link{
  display: inline-flex; align-items: center; gap: 7px;
  color: var(--accent); font-weight: 600; font-size: .88rem;
}
.project-link svg{ transition: transform var(--transition); }
.project-link:hover svg{ transform: translate(2px, -2px); }

/* ============ CONTACT ============ */
.contact-section{ text-align: center; }
.contact-lead{ color: var(--text-muted); max-width: 56ch; margin: 0 auto 40px; }
.contact-grid{
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  max-width: 760px;
  margin: 0 auto;
}
.contact-card{
  display: flex; flex-direction: column; align-items: center; gap: 10px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 22px 12px;
  font-size: .88rem;
  color: var(--text-muted);
  transition: border-color var(--transition), color var(--transition), transform var(--transition);
}
.contact-card:hover{ border-color: var(--accent); color: var(--text); transform: translateY(-3px); }
.contact-card svg{ color: var(--accent); }

/* ============ FOOTER ============ */
.site-footer{
  border-top: 1px solid var(--border);
  padding: 26px 28px;
  text-align: center;
  color: var(--text-muted);
  font-size: .85rem;
  position: relative; z-index: 1;
}

/* ============ i18n fade ============ */
[data-i18n]{ transition: opacity 160ms ease; }
.i18n-fading{ opacity: 0; }

/* ============ RESPONSIVE ============ */
@media (max-width: 960px){
  .main-nav{ display: none; }
  .nav-toggle{ display: flex; }
  .main-nav.nav-open{
    display: flex;
    position: absolute;
    top: 100%; left: 0; right: 0;
    flex-direction: column;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 18px 28px;
    gap: 16px;
  }
  .hero-inner{ grid-template-columns: 1fr; text-align: center; }
  .hero-meta, .hero-cta, .hero-links{ justify-content: center; }
  .hero-bio{ margin-inline: auto; }
  .hero-portrait{ order: -1; }
  .skills-grid{ grid-template-columns: repeat(2, 1fr); }
  .projects-grid{ grid-template-columns: 1fr; }
}

@media (max-width: 640px){
  .header-inner{ padding: 12px 18px; }
  .whatsapp-btn span{ display: none; }
  .whatsapp-btn{ padding: 9px; }
  .section{ padding: 68px 0; }
  .section-inner{ padding: 0 20px; }
  .skills-grid{ grid-template-columns: 1fr; }
  .contact-grid{ grid-template-columns: repeat(2, 1fr); }
  .edu-card{ flex-direction: column; }
  .edu-mark{ width: 100%; height: 4px; }
}

@media (prefers-reduced-motion: reduce){
  *{ animation: none !important; transition: none !important; scroll-behavior: auto !important; }
}

</style>
</head>
